#!/usr/bin/env sh
#MISE description="Stamp every tracked file's mtime with the checked-out commit's committer date"

set -e

export TZ=UTC

ts="$(git log -1 --format=%ct)"
stamp="$(date -d "@${ts}" +%Y%m%d%H%M.%S 2>/dev/null || date -r "${ts}" +%Y%m%d%H%M.%S)"
git ls-files -z | xargs -0 touch -t "${stamp}"
echo "commit-mtime: stamped tracked files with ${stamp} (UTC)"
