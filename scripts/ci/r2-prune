#!/usr/bin/env sh
#MISE description="Prune the R2 cache: keep the newest rust-cache object per (namespace, os, rustc, part) group and the newest 2 icon archives"

set -e

r2="$(dirname "$0")/r2"

failures="$(mktemp)"
trap 'rm -f "${failures}"' EXIT

prune_delete() {
  key="$1"
  echo "prune: deleting ${key}"
  if ! "${r2}" delete "${key}"; then
    echo "prune: WARNING delete command failed for ${key}" >&2
    echo "${key}" >>"${failures}"
    return
  fi
  if "${r2}" exists "${key}"; then
    echo "prune: WARNING ${key} still present after delete" >&2
    echo "${key}" >>"${failures}"
  fi
}

# WARNING: the rust-cache grouping heuristic below is UNVALIDATED — it is the
# port of the guard that used to live in build.yml's gh-cache pruner. It strips
# each object's trailing Cargo.lock-hash segment to group siblings and keeps only
# the newest object per group, assuming an older lock-keyed object is always dead
# weight (restore falls back to the newest matching prefix anyway). Validate it
# against one real `mise run ci:r2 list rust-cache/` before trusting the deletes.
# The R2 lifecycle rules (see .github/r2/) are the real size backstop; this job
# only trims sooner. A wrong-but-successful delete never breaks CI; only a delete
# that leaves its object present surfaces as a job failure.

echo "prune: rust-cache/ — keeping the newest object per group"
"${r2}" list "rust-cache/" 2>/dev/null |
  awk -F';' '
    NF < 2 { next }
    {
      time = $1
      name = $2
      if (name ~ /\.cargo\.tar\.gz$/) part = "cargo"
      else if (name ~ /\.target\.tar\.gz$/) part = "target"
      else next
      base = name
      sub("\\." part "\\.tar\\.gz$", "", base)
      sub("-[^-]*$", "", base)
      group = base "|" part
      if (!(group in best_time) || time > best_time[group]) {
        if (group in best_name) print best_name[group]
        best_time[group] = time
        best_name[group] = name
      } else {
        print name
      }
    }
  ' |
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    prune_delete "rust-cache/${name}"
  done

echo "prune: icons/ — keeping the newest 2 archives"
"${r2}" list "icons/" 2>/dev/null |
  awk -F';' 'NF >= 2 && $2 ~ /\.tar\.zst$/' |
  sort -r |
  awk -F';' 'NR > 2 { print $2 }' |
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    prune_delete "icons/${name}"
  done

if [ -s "${failures}" ]; then
  echo "prune: FAILED — objects still present after delete:" >&2
  cat "${failures}" >&2
  exit 1
fi

echo "prune: done"
