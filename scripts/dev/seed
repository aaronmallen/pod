def main():
    parser = argparse.ArgumentParser(
        description="Seed the local dev database with fake data for screenshots/demos.")
    parser.add_argument("--db", default=DEFAULT_DB, help="path to the pod sqlite db")
    parser.add_argument("--reset", action="store_true",
                        help="also clear augment-style tables before seeding")
    parser.add_argument("--no-backup", action="store_true",
                        help="skip the pre-write backup copy")
    parser.add_argument("--seed", type=int, default=1337, help="RNG seed")
    args = parser.parse_args()

    db_path = os.path.abspath(args.db)
    if not os.path.exists(db_path):
        print("error: db not found: %s" % db_path, file=sys.stderr)
        sys.exit(1)

    backup_path = None
    if not args.no_backup:
        backup_path = "%s.seed-backup-%d" % (db_path, int(time.time()))
        shutil.copy2(db_path, backup_path)
        print("backup: %s" % backup_path)

    rng = random.Random(args.seed)
    conn = sqlite3.connect(db_path)
    conn.execute("PRAGMA foreign_keys=ON")
    try:
        conn.execute("BEGIN")
        pools = load_pools(conn)
        ctx = Ctx(conn, rng, pools)
        if not ctx.chars:
            raise RuntimeError("no characters in db; nothing to seed")

        # idempotency: always clear synthetic ranges first
        clear_synth_ranges(ctx)
        if args.reset:
            reset_augment(ctx)

        seed_killmails(ctx)
        seed_industry_jobs(ctx)
        seed_blueprints(ctx)
        seed_extractions(ctx)
        seed_assets(ctx)
        seed_finance(ctx)
        seed_standings(ctx)
        seed_clones(ctx)
        seed_calendar(ctx)
        seed_mail(ctx)
        seed_notifications(ctx)
        seed_contacts(ctx)
        seed_captains_log(ctx)

        conn.commit()
    except Exception as exc:  # noqa: BLE001
        conn.rollback()
        print("error: seeding failed, rolled back: %s" % exc, file=sys.stderr)
        import traceback
        traceback.print_exc()
        conn.close()
        sys.exit(1)

    # summary
    print()
    print("seeded tables (table -> rows inserted):")
    for table in sorted(ctx.counts):
        print("  %-38s %d" % (table, ctx.counts[table]))
    print()
    print("main corp: %d (%s); director/installer: %s" % (
        ctx.main_corp, "Pod Developers",
        ctx.director["name"] if ctx.director else "?"))
    if backup_path:
        print("backup: %s" % backup_path)
    conn.close()


if __name__ == "__main__":
    main()
