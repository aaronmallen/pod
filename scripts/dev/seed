    2124475947: 6004.52,
    2124475968: 6805.22,
}
CORP_NW_ANCHOR = 2100490000.0


def _char_wallet_end_balance(char_id):
    """Plausible ending wallet balance for the char's liquid series."""
    nw = CHAR_NW_ANCHOR.get(char_id, 500000.0)
    # liquid is a fraction of net worth (rest is assets)
    return max(50000.0, nw * 0.6)


def seed_finance(ctx):
    rng = ctx.rng
    pools = ctx.pools
    tradeable = pools["tradeable"] or [(34, 5.0)]
    station_region = {s[0]: s[1] for s in pools["station_region"]}
    hub_stations = list(station_region.keys()) or [60003760]
    npc_corps = [1000044, 1000045, 1000172]

    # --- character wallet journal + transactions ---
    for ci, ch in enumerate(ctx.chars):
        cid = ch["id"]
        jbase = BASE_CHAR_JOURNAL + ci * 100000
        tbase = BASE_CHAR_TXN + ci * 100000
        jc = [0]
        tc = [0]
        end_balance = _char_wallet_end_balance(cid)
        balance = end_balance
        # generate dated entries newest-first so larger id == newer
        n_txn = rng.randint(25, 40)
        dates = sorted([days_ago(rng, 1, 90) for _ in range(n_txn)], reverse=True)
        for d in dates:
            tp = rng.choice(tradeable)
            type_id, avg = tp[0], float(tp[1])
            unit = jitter(rng, avg)
            qty = rng.randint(1, 2000)
            gross = unit * qty
            is_buy = rng.random() < 0.5
            station = rng.choice(hub_stations)
            jc[0] += 1
            journal_id = jbase + jc[0]
            tc[0] += 1
            txn_id = tbase + tc[0]
            if is_buy:
                amount = -gross
            else:
                amount = gross
            # market_transaction journal row paired to the txn
            ctx.conn.execute(
                """INSERT INTO character_wallet_journal
                (id, character_id, date, description, ref_type, amount, balance,
                context_id, context_id_type, first_party_id, reason, second_party_id,
                tax, tax_receiver_id)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (journal_id, cid, iso_z(d),
                "Market: %s %s" % (qty, "bought" if is_buy else "sold"),
                "market_transaction", round(amount, 2), round(balance, 2),
                txn_id, "market_transaction_id", cid, None, station, None, None),
            )
            ctx.bump("character_wallet_journal")
            ctx.conn.execute(
                """INSERT INTO character_wallet_transaction
                (transaction_id, character_id, client_id, date, is_buy, is_personal,
                journal_ref_id, location_id, quantity, type_id, unit_price)
                VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
                (txn_id, cid, rng.choice(npc_corps + [rng.randint(90_000_000, 2_120_000_000)]),
                iso_z(d), 1 if is_buy else 0, 1, journal_id, station, qty, type_id,
                round(unit, 2)),
            )
            ctx.bump("character_wallet_transaction")
            balance -= amount  # walk backwards in time
            # tax for sells
            if not is_buy:
                tax = gross * 0.045
                jc[0] += 1
                ctx.conn.execute(
                    """INSERT INTO character_wallet_journal
                    (id, character_id, date, description, ref_type, amount, balance,
                    context_id, context_id_type, first_party_id, reason, second_party_id,
                    tax, tax_receiver_id)
                    VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                    (jbase + jc[0], cid, iso_z(d), "Sales tax", "transaction_tax",
                    round(-tax, 2), round(balance, 2), None, None, cid, None, None,
                    None, None),
                )
                ctx.bump("character_wallet_journal")
                balance += tax
        # a few non-market journal rows (bounties, donations, fees)
        for _ in range(rng.randint(8, 16)):
            d = days_ago(rng, 1, 90)
            ref = rng.choice(["bounty_prizes", "player_donation", "brokers_fee",
                              "insurance", "skill_purchase", "jump_clone_activation_fee",
                              "agent_mission_reward", "daily_goal_payouts"])
            if ref in ("bounty_prizes", "player_donation", "insurance",
                      "agent_mission_reward", "daily_goal_payouts"):
                amount = rng.uniform(50_000, 5_000_000)
            else:
                amount = -rng.uniform(10_000, 1_000_000)
            jc[0] += 1
            ctx.conn.execute(
                """INSERT INTO character_wallet_journal
                (id, character_id, date, description, ref_type, amount, balance,
                context_id, context_id_type, first_party_id, reason, second_party_id,
                tax, tax_receiver_id)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (jbase + jc[0], cid, iso_z(d), "-", ref, round(amount, 2),
                round(balance, 2), None, None, cid, None,
                rng.choice(npc_corps), None, None),
            )
            ctx.bump("character_wallet_journal")

        # --- market orders for this char ---
        for _ in range(rng.randint(8, 15)):
            tp = rng.choice(tradeable)
            type_id, avg = tp[0], float(tp[1])
            station = rng.choice(hub_stations)
            region = station_region.get(station, 10000002)
            is_buy = rng.random() < 0.5
            vol_total = rng.randint(10, 5000)
            vol_remain = rng.randint(1, vol_total)
            state = rng.choices(["open", "expired", "cancelled"], weights=[70, 15, 15])[0]
            if is_buy:
                price = jitter(rng, avg * 0.95)
                escrow = price * vol_remain
                rng_str = rng.choice(["station", "solarsystem", "1", "5", "10", "region"])
            else:
                price = jitter(rng, avg * 1.05)
                escrow = 0.0
                rng_str = "region"
            ctx.counts_order = ctx.counts.get("market_orders", 0)
            order_id = BASE_MARKET_ORDER + (ctx.counts.get("market_orders", 0)
                                            + (ci * 1000)) + rng.randint(1, 999)
            # ensure uniqueness via a monotonic counter
            order_id = BASE_MARKET_ORDER + _next_order(ctx)
            ctx.conn.execute(
                """INSERT INTO market_orders
                (order_id, character_id, type_id, region_id, location_id, is_buy_order,
                price, volume_remain, volume_total, escrow, range, duration, issued, state)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (order_id, cid, type_id, region, station, 1 if is_buy else 0,
                round(price, 2), vol_remain, vol_total, round(escrow, 2), rng_str,
                rng.choice([1, 3, 7, 14, 30, 90]), iso_z(days_ago(rng, 0, 30)), state),
            )
            ctx.bump("market_orders")

    # --- corp wallet journal + transactions (division 1 mostly) ---
    corp = ctx.main_corp
    director = ctx.director["id"] if ctx.director else ctx.chars[0]["id"]
    cjc = [0]
    ctxn = [0]
    corp_balance = CORP_NW_ANCHOR
    n = rng.randint(30, 50)
    dates = sorted([days_ago(rng, 1, 90) for _ in range(n)], reverse=True)
    for d in dates:
        division = 1 if rng.random() < 0.7 else rng.randint(2, 7)
        roll = rng.random()
        cjc[0] += 1
        journal_id = BASE_CORP_JOURNAL + cjc[0]
        if roll < 0.4:
            # market transaction pair
            tp = rng.choice(tradeable)
            type_id, avg = tp[0], float(tp[1])
            unit = jitter(rng, avg)
            qty = rng.randint(10, 5000)
            gross = unit * qty
            is_buy = rng.random() < 0.5
            amount = -gross if is_buy else gross
            ctxn[0] += 1
            txn_id = BASE_CORP_TXN + ctxn[0]
            ctx.conn.execute(
                """INSERT INTO corporation_wallet_journal
                (id, corporation_id, division, date, description, ref_type, amount,
                balance, context_id, context_id_type, first_party_id, reason,
                second_party_id, tax, tax_receiver_id)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (journal_id, corp, division, iso_z(d), "Market transaction",
                "market_transaction", round(amount, 2),
                round(corp_balance if division == 1 else rng.uniform(0, 5_000_000), 2),
                txn_id, "market_transaction_id", director, None, corp, None, None),
