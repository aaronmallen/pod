            ctx.bump("corporation_wallet_journal")
            ctx.conn.execute(
                """INSERT INTO corporation_wallet_transaction
                (transaction_id, corporation_id, division, client_id, date, is_buy,
                journal_ref_id, location_id, quantity, type_id, unit_price)
                VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
                (txn_id, corp, division, rng.randint(90_000_000, 2_120_000_000), iso_z(d),
                1 if is_buy else 0, journal_id, 60003760, qty, type_id, round(unit, 2)),
            )
            ctx.bump("corporation_wallet_transaction")
            if division == 1:
                corp_balance -= amount
        else:
            ref = rng.choice(["market_escrow", "bounty_prizes", "daily_goal_payouts",
                              "player_donation", "corporation_account_withdrawal",
                              "contract_reward_deposited_corp", "ess_escrow_transfer",
                              "transaction_tax"])
            if ref in ("bounty_prizes", "daily_goal_payouts", "player_donation",
                      "contract_reward_deposited_corp", "ess_escrow_transfer"):
