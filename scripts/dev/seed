def seed_contacts(ctx):
    rng = ctx.rng
    chars = ctx.chars
    director_id = ctx.director["id"] if ctx.director else None
    # ensure 'alts' label exists for the 3 non-director chars (Pod Dev already has label 1)
    for ch in chars:
        if ch["id"] == director_id:
            continue
        ctx.conn.execute(
            """INSERT OR IGNORE INTO character_contact_labels
            (character_id, label_id, label_name) VALUES (?,?,?)""",
            (ch["id"], 1, "alts"),
        )

    for ch in chars:
        cid = ch["id"]
        # cross-add the other 3 chars
        for other in chars:
            if other["id"] == cid:
                continue
            ctx.conn.execute(
                """INSERT INTO character_contacts
                (character_id, contact_id, contact_type, standing, is_watched,
                is_blocked, label_ids, contact_name)
                VALUES (?,?,?,?,?,?,?,?)""",
                (cid, other["id"], "character", 10.0, 1, 0, "[1]", other["name"]),
            )
            ctx.bump("character_contacts")
        # corp contact
        ctx.conn.execute(
            """INSERT INTO character_contacts
            (character_id, contact_id, contact_type, standing, is_watched,
            is_blocked, label_ids, contact_name)
            VALUES (?,?,?,?,?,?,?,?)""",
            (cid, ctx.main_corp, "corporation", 10.0, 0, 0, "[]", "Pod Developers"),
        )
        ctx.bump("character_contacts")
        # misc contacts incl a blocked/negative one
        used = set([c["id"] for c in chars] + [ctx.main_corp])
        for _ in range(rng.randint(4, 8)):
            misc_id = rng.randint(90_000_000, 2_120_000_000)
            if misc_id in used:
                continue
            used.add(misc_id)
            blocked = rng.random() < 0.2
            standing = round(rng.uniform(-10.0, -2.0), 1) if blocked else round(
                rng.uniform(-5.0, 10.0), 1)
            try:
                ctx.conn.execute(
                    """INSERT INTO character_contacts
                    (character_id, contact_id, contact_type, standing, is_watched,
                    is_blocked, label_ids, contact_name)
                    VALUES (?,?,?,?,?,?,?,?)""",
                    (cid, misc_id, "character", standing, 0, 1 if blocked else 0, "[]",
                    "Pilot %d" % misc_id),
                )
                ctx.bump("character_contacts")
            except sqlite3.IntegrityError:
                pass


