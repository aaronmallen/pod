# Day offsets (from LOG_NOW) that get a captains_log row. The activity-only day
# (CL_ACTIVITY_ONLY_OFFSET) deliberately has none. captains_log is keyed by date
# with no synthetic id to gate on, so the reset deletes exactly these dates.
CL_ROW_OFFSETS = (0, 1, 2, 3, 9)
CL_ACTIVITY_ONLY_OFFSET = 4


def cl_log_row_dates():
    """The exact captains_log dates this run seeds (for the idempotent reset)."""
    return [date_only(LOG_NOW - dt.timedelta(days=d)) for d in CL_ROW_OFFSETS]


def clear_synth_ranges(ctx):
    """Always-run clearing of the synthetic id bands so re-runs are idempotent."""
    conn = ctx.conn
    char_ids = [c["id"] for c in ctx.chars]
    for table, col, base in SYNTH_RANGES:
        conn.execute("DELETE FROM %s WHERE %s >= ?" % (table, col), (base,))
    # captains_log has no synthetic id band -> clear the exact dates we reseed.
    dates = cl_log_row_dates()
    conn.execute(
        "DELETE FROM captains_log WHERE date IN (%s)" % ",".join("?" * len(dates)),
        dates,
    )
    # char-scoped composite-PK tables: clear seeded rows for our chars.
    for table, col in CHAR_SCOPED_CLEAR:
        if char_ids:
            conn.execute(
                "DELETE FROM %s WHERE %s IN (%s)"
                % (table, col, ",".join("?" * len(char_ids))),
                char_ids,
            )


def reset_augment(ctx):
    """--reset: additionally clear augment-style tables (synthetic contact labels)."""
    conn = ctx.conn
    char_ids = [c["id"] for c in ctx.chars]
    # remove the synthetic 'alts' contact-label rows we add for the 3 non-Pod-Dev chars
