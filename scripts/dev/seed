def iso_z(when):
    """ISO8601 UTC with trailing Z, second precision: 'YYYY-MM-DDTHH:MM:SSZ'."""
    return when.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def iso_offset(when):
    """RFC3339 with fractional seconds + offset: 'YYYY-MM-DDTHH:MM:SS.ffffff+00:00'."""
    return when.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f+00:00")


def date_only(when):
    """Plain DATE 'YYYY-MM-DD'."""
    return when.astimezone(dt.timezone.utc).strftime("%Y-%m-%d")


def days_ago(rng, lo, hi, base=NOW):
    secs = rng.randint(lo * 86400, hi * 86400)
    return base - dt.timedelta(seconds=secs)


def days_ahead(rng, lo, hi, base=NOW):
    secs = rng.randint(lo * 86400, hi * 86400)
    return base + dt.timedelta(seconds=secs)


def hexhash(rng):
    return "".join(rng.choice("0123456789abcdef") for _ in range(40))


def jitter(rng, value, frac=0.10):
    return value * (1.0 + rng.uniform(-frac, frac))


def weighted_sample(rng, pool, n):
    """Sample n distinct items from pool, weighting earlier (common) items higher."""
    if not pool:
        return []
    n = min(n, len(pool))
    weights = [max(1.0, len(pool) - i) for i in range(len(pool))]
    chosen = []
    items = list(pool)
    w = list(weights)
    for _ in range(n):
        total = sum(w)
        r = rng.uniform(0, total)
        acc = 0.0
        for idx, weight in enumerate(w):
            acc += weight
            if r <= acc:
                chosen.append(items.pop(idx))
                w.pop(idx)
                break
    return chosen


def query(conn, sql, params=()):
    cur = conn.execute(sql, params)
    return cur.fetchall()


def market_price(conn, type_id):
    row = conn.execute(
        "SELECT average_price FROM market_prices WHERE type_id=?", (type_id,)
    ).fetchone()
    if row and row[0]:
        return float(row[0])
    return 1000.0


