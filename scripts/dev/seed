            VALUES (?,?,?,?,?)""",
            (char["id"], eid, note, ts, ts),
        )
        ctx.bump("calendar_event_notes")

    # -- offset 0: Today -- busy day, fully answered, every engagement debriefed --
    d0 = day(0, hour=21)
    k0a = make_kill(ch(0), True, d0.replace(minute=2))
    k0b = make_kill(ch(1), True, d0.replace(minute=8))
