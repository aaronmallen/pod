# EVE inventory slot flags
HIGH = [27, 28, 29, 30]
MID = [19, 20, 21, 22]
LOW = [11, 12, 13, 14]
RIG = [92, 93, 94]
SUBSYS = [125, 126, 127, 128, 129]
DRONE = 87
CARGO = 5
IMPLANT = 89


def _build_fit_items(ctx, killmail_id, lens_char, is_t3c, is_pod, total_value):
    """Return a coherent list of item dicts for a fit. value sums tracked by caller."""
    rng = ctx.rng
    pools = ctx.pools
    items = []
    ord_n = [0]

    def add(type_id, flag, qty, value, dropped):
        items.append({
            "ordinal": ord_n[0],
            "type_id": type_id,
            "flag": flag,
            "destroyed": 0 if dropped else qty,
            "dropped": qty if dropped else 0,
            "value": value,
        })
        ord_n[0] += 1

    if is_pod:
        for imp in (pools["implants5"] or [])[:5]:
            add(imp[0], IMPLANT, 1, jitter(rng, 12_000_000.0), rng.random() < 0.3)
        return items

    mods = pools["modules"]
    rigs = pools["rigs"]
    drones = pools["drones"]
    ammo = pools["ammo"]
    subs = pools["subsystems"]

    def pick(pool):
        return rng.choice(pool)[0] if pool else 34

    # high
    for f in HIGH[:3]:
        add(pick(mods), f, 1, jitter(rng, total_value * 0.05), rng.random() < 0.5)
    # mid
    for f in MID[:3]:
        add(pick(mods), f, 1, jitter(rng, total_value * 0.04), rng.random() < 0.5)
    # low
    for f in LOW[:3]:
        add(pick(mods), f, 1, jitter(rng, total_value * 0.04), rng.random() < 0.5)
    # rigs
    for f in RIG[:rng.randint(2, 3)]:
        add(pick(rigs), f, 1, jitter(rng, total_value * 0.03), rng.random() < 0.4)
    # ammo / cargo
    for _ in range(rng.randint(1, 3)):
        add(pick(ammo), CARGO, rng.randint(100, 5000), jitter(rng, total_value * 0.01),
            rng.random() < 0.6)
    # drones
    if rng.random() < 0.6:
        for _ in range(rng.randint(1, 3)):
            add(pick(drones), DRONE, rng.randint(1, 5), jitter(rng, total_value * 0.02),
                rng.random() < 0.5)
    # subsystems for T3C
    if is_t3c and subs:
        for f in SUBSYS[:rng.randint(4, 5)]:
            add(pick(subs), f, 1, jitter(rng, total_value * 0.06), rng.random() < 0.3)
    return items


def _build_attackers(ctx, is_kill, lens_char, final_blow_self):
    """Return (attacker rows list, total damage). One final_blow=1."""
    rng = ctx.rng
    pools = ctx.pools
    n = 1 if rng.random() < 0.25 else rng.randint(2, 8)
    hulls = pools["ship_hulls"]
    attackers = []
    self_ordinal = None
    if is_kill:
        # one attacker is the lens char itself
        self_ordinal = rng.randint(0, n - 1)
    for i in range(n):
        is_self = (i == self_ordinal)
        if is_self:
            acid = lens_char["id"]
            corp = lens_char["corp"]
            alliance = None
        else:
            acid = rng.randint(90_000_000, 2_120_000_000)
            corp = rng.choice([98654335, 98668272, 1000044, 1000045, 1000172,
                              rng.randint(98_000_000, 98_999_999)])
            alliance = rng.choice([None, None, 99003581, 99001105, 99010079])
        attackers.append({
            "ordinal": i,
            "attacker_character_id": acid,
            "corporation_id": corp,
            "alliance_id": alliance,
            "ship_type_id": rng.choice(hulls)[0] if hulls else 587,
            "damage_done": rng.randint(200, 9000),
            "final_blow": 0,
        })
    # assign exactly one final blow
    if is_kill and final_blow_self and self_ordinal is not None:
        fb = self_ordinal
    else:
        fb = rng.randrange(n)
    attackers[fb]["final_blow"] = 1
    total_dmg = sum(a["damage_done"] for a in attackers)
    return attackers, total_dmg, fb


def _gen_killmail(ctx, kid, lens_char, is_kill):
    """Generate one killmail's data (parent row + attackers + items)."""
    rng = ctx.rng
    pools = ctx.pools
    hulls = pools["ship_hulls"]
    systems = (pools["pvp_systems"] or []) + (pools["low_null_systems"] or [])
    system_id = rng.choice(systems)[0] if systems else 30002813

    is_pod = (not is_kill) and rng.random() < 0.18
    if is_pod:
        ship_type_id = pools["capsule"]
        grp = "Capsule"
    else:
        hull = rng.choice(hulls) if hulls else (587, "Rifter", "Frigate")
        ship_type_id = hull[0]
        grp = hull[2] if len(hull) > 2 else "Frigate"
    is_t3c = grp == "Strategic Cruiser"

    # value by hull class
    if is_pod:
        total_value = jitter(rng, rng.uniform(50_000_000, 400_000_000))
    elif grp in ("Frigate", "Assault Frigate", "Interceptor", "Covert Ops"):
        total_value = jitter(rng, rng.uniform(5_000_000, 50_000_000))
    elif grp in ("Destroyer", "Interdictor"):
        total_value = jitter(rng, rng.uniform(15_000_000, 80_000_000))
    elif grp in ("Cruiser",):
        total_value = jitter(rng, rng.uniform(80_000_000, 300_000_000))
    elif grp in ("Battlecruiser",):
        total_value = jitter(rng, rng.uniform(150_000_000, 400_000_000))
    elif grp in ("Strategic Cruiser",):
        total_value = jitter(rng, rng.uniform(800_000_000, 2_000_000_000))
    elif grp in ("Battleship",):
        total_value = jitter(rng, rng.uniform(300_000_000, 900_000_000))
    else:
        total_value = jitter(rng, rng.uniform(50_000_000, 200_000_000))

    # final blow on lens char (kills only): ~50% of kills
    final_blow_self = is_kill and rng.random() < 0.5
    attackers, total_dmg, fb = _build_attackers(ctx, is_kill, lens_char, final_blow_self)
    parent_final_blow = 1 if (is_kill and attackers[fb]["attacker_character_id"] == lens_char["id"]) else 0

    items = _build_fit_items(ctx, kid, lens_char, is_t3c, is_pod, total_value)
    dropped_value = sum(i["value"] for i in items if i["dropped"] > 0)
    value_destroyed = max(0.0, total_value - dropped_value)

    kt = days_ago(rng, 1, 60)
    kill_time = iso_z(kt)
    synced_at = iso_offset(kt + dt.timedelta(hours=rng.randint(1, 48)))

    if is_kill:
        victim_id = rng.randint(90_000_000, 2_120_000_000)
        victim_corp = rng.choice([98654335, 98668272, 1000044, 1000045,
                                  rng.randint(98_000_000, 98_999_999)])
    else:
        victim_id = lens_char["id"]
        victim_corp = lens_char["corp"]

    return {
        "killmail_id": kid,
        "kill_hash": hexhash(rng),
        "is_kill": 1 if is_kill else 0,
        "ship_type_id": ship_type_id,
        "victim_id": victim_id,
        "victim_corp_id": victim_corp,
        "system_id": system_id,
        "value_isk": round(total_value, 2),
        "value_destroyed_isk": round(value_destroyed, 2),
        "attacker_count": len(attackers),
        "final_blow": parent_final_blow,
        "kill_time": kill_time,
        "synced_at": synced_at,
        "victim_damage_taken": total_dmg,
        "attackers": attackers,
        "items": items,
    }


def seed_killmails(ctx):
    conn = ctx.conn
    rng = ctx.rng
    counter = [0]

    def next_kid():
        counter[0] += 1
        return BASE_KILLMAIL + counter[0]

    pod_dev_kills = []  # killmails for the player-corp char, fan out to corp

    for ch in ctx.chars:
        n_total = rng.randint(20, 30)
        n_loss = int(n_total * rng.uniform(0.60, 0.70))
        flags = [False] * n_loss + [True] * (n_total - n_loss)  # False=loss, True=kill
        rng.shuffle(flags)
        for is_kill in flags:
            kid = next_kid()
            km = _gen_killmail(ctx, kid, ch, is_kill)
            _insert_char_killmail(ctx, ch["id"], km)
            if ch["corp"] == ctx.main_corp:
                pod_dev_kills.append(km)

    # corp killmails: Pod Dev's kills/losses + a few corp-only.
    corp = ctx.main_corp
    director = ctx.director
    shared = pod_dev_kills[:]  # all of them are corp-visible
    for km in shared:
        _insert_corp_killmail(ctx, corp, km)
    # a few corp-only kills (other corp members)
    for _ in range(rng.randint(3, 6)):
        kid = next_kid()
        is_kill = rng.random() < 0.4
        km = _gen_killmail(ctx, kid, director, is_kill)
        # corp-only loss victim is a corp member (Pod Dev)
        if not is_kill:
            km["victim_id"] = director["id"]
            km["victim_corp_id"] = corp
        _insert_corp_killmail(ctx, corp, km)


