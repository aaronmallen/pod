# ESI job activity ids
ACT_MANUFACTURING = 1
ACT_TE = 3
ACT_ME = 4
ACT_COPY = 5
ACT_INVENTION = 8
ACT_REACTION = 9


def _station_id(ctx):
    stations = ctx.pools["stations"]
    return ctx.rng.choice(stations)[0] if stations else 60003760


def _bp_for_activity(ctx, activity_id):
    """Return (blueprint_type_id, product_type_id) appropriate for activity."""
    rng = ctx.rng
    pools = ctx.pools
    if activity_id == ACT_REACTION and pools["reaction_bp"]:
        bp = rng.choice(pools["reaction_bp"])
        return bp[0], bp[1]
    if activity_id == ACT_INVENTION and pools["invention_bp"]:
        bp = rng.choice(pools["invention_bp"])
        return bp[0], bp[1]
    pool = pools["mfg_bp"] or pools["mfg_bp_broad"]
    if pool:
        bp = rng.choice(pool)
        return bp[0], bp[1]
    return 691, 587


def _make_job(ctx, job_id, owner_kind, owner_id, installer_id, activity_id, kind):
    """kind in {active, delivered, ready, paused, cancelled}."""
    rng = ctx.rng
    bp_type, product_type = _bp_for_activity(ctx, activity_id)
    station = _station_id(ctx)
    runs = rng.randint(1, 200) if activity_id == ACT_MANUFACTURING else (
        rng.randint(1, 10) if activity_id in (ACT_COPY, ACT_INVENTION) else
        rng.randint(1, 50))
    duration = rng.randint(3600, 864000)
    cost = round(rng.uniform(1000, 5_000_000), 2)
    probability = round(rng.uniform(0.26, 0.62), 2) if activity_id == ACT_INVENTION else None
    licensed_runs = rng.randint(1, 10) if activity_id in (ACT_COPY, ACT_INVENTION) else None
    bp_base = BASE_CHAR_BP if owner_kind == "char" else BASE_CORP_BP
    blueprint_id = bp_base + (job_id % 1_000_000)

    completed_char = None
    completed_date = None
    pause_date = None
    successful = None
    status = kind

    if kind in ("delivered", "ready", "cancelled"):
        end = days_ago(rng, 1, 30)
        start = end - dt.timedelta(seconds=duration)
        if kind in ("delivered", "ready"):
            completed_char = installer_id
            completed_date = iso_z(end)
            successful = runs if activity_id != ACT_INVENTION else rng.randint(0, runs)
    elif kind == "paused":
        end = days_ahead(rng, 1, 15)
        start = end - dt.timedelta(seconds=duration)
        pause_date = iso_z(days_ago(rng, 0, 2))
    else:  # active
        end = days_ahead(rng, 0, 14)
        # ensure start is in the recent past
        start = end - dt.timedelta(seconds=duration)
        if start > NOW:
            start = days_ago(rng, 1, 5)
            end = start + dt.timedelta(seconds=duration)

    return {
        "job_id": job_id,
        "owner_id": owner_id,
        "activity_id": activity_id,
        "blueprint_id": blueprint_id,
        "blueprint_location_id": station,
        "blueprint_type_id": bp_type,
        "completed_character_id": completed_char,
        "completed_date": completed_date,
        "cost": cost,
        "duration": duration,
        "end_date": iso_z(end),
        "facility_id": station,
        "installer_id": installer_id,
        "licensed_runs": licensed_runs,
        "output_location_id": station,
        "pause_date": pause_date,
        "probability": probability,
        "product_type_id": product_type if activity_id != ACT_COPY else None,
        "runs": runs,
        "start_date": iso_z(start),
        "station_id": station,
        "status": status,
        "successful_runs": successful,
    }


