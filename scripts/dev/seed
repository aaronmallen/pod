def seed_net_worth(ctx):
    rng = ctx.rng
    nw_id = [0]

    def next_char_nw():
        nw_id[0] += 1
        return BASE_CHAR_NW + nw_id[0]

    cnw_id = [0]

    def next_corp_nw():
        cnw_id[0] += 1
        return BASE_CORP_NW + cnw_id[0]

    # character snapshots: ~90 days, trend gently up to the real anchor.
    for ch in ctx.chars:
        cid = ch["id"]
        anchor = CHAR_NW_ANCHOR.get(cid, 500000.0)
        asset_anchor = anchor * 0.4
        liquid_anchor = anchor - asset_anchor
        for back in range(89, -1, -1):
            d = NOW - dt.timedelta(days=back)
            # growth factor: older days slightly lower
            growth = 1.0 - (back / 90.0) * rng.uniform(0.15, 0.30)
            liquid = max(0.0, round(liquid_anchor * growth, 2))
            asset_value = max(0.0, round(asset_anchor * growth, 2))
            escrow = round(rng.uniform(0, asset_anchor * 0.05), 2) if rng.random() < 0.3 else 0.0
            net = round(liquid + asset_value + escrow, 2)
            ctx.conn.execute(
                """INSERT INTO character_net_worth_snapshot
                (id, character_id, date, liquid, asset_value, escrow, net_worth)
                VALUES (?,?,?,?,?,?,?)
                ON CONFLICT(character_id, date) DO UPDATE SET
                  liquid=excluded.liquid, asset_value=excluded.asset_value,
                  escrow=excluded.escrow, net_worth=excluded.net_worth""",
                (next_char_nw(), cid, date_only(d), liquid, asset_value, escrow, net),
            )
            ctx.bump("character_net_worth_snapshot")

    # corp snapshots
    corp = ctx.main_corp
    for back in range(89, -1, -1):
        d = NOW - dt.timedelta(days=back)
        growth = 1.0 - (back / 90.0) * rng.uniform(0.10, 0.25)
        liquid = round(CORP_NW_ANCHOR * growth, 2)
        ctx.conn.execute(
            """INSERT INTO corporation_net_worth_snapshot
            (id, corporation_id, date, liquid, net_worth)
            VALUES (?,?,?,?,?)
            ON CONFLICT(corporation_id, date) DO UPDATE SET
              liquid=excluded.liquid, net_worth=excluded.net_worth""",
            (next_corp_nw(), corp, date_only(d), liquid, liquid),
        )
        ctx.bump("corporation_net_worth_snapshot")


