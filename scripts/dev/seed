def seed_extractions(ctx):
    rng = ctx.rng
    pools = ctx.pools
    moons = list(pools["moons"])
    if not moons:
        return
    corp = ctx.main_corp
    # 2-3 structures
    n_struct = min(3, max(2, len(moons) // 2))
    structs = [BASE_EXTRACTION_STRUCT + i + 1 for i in range(n_struct)]
    # state recipe: spread Extracting / Imminent / Ready / Fractured
    states = (["extracting"] * 3 + ["imminent"] * 2 + ["ready"] * 2 + ["fractured"])
    rng.shuffle(states)
    moon_idx = 0
    rows = 0
    target = rng.randint(5, 9)
    for state in states:
        if rows >= target or moon_idx >= len(moons):
            break
        moon = moons[moon_idx]
        moon_idx += 1
        struct = rng.choice(structs)
        if state == "extracting":
            arrival = days_ahead(rng, 3, 10)
        elif state == "imminent":
            arrival = NOW + dt.timedelta(seconds=rng.randint(3600, 80000))
        elif state == "ready":
            arrival = days_ago(rng, 0, 1)
        else:  # fractured
            arrival = days_ago(rng, 3, 6)
        decay = arrival + dt.timedelta(days=2)
        if state == "fractured":
            decay = days_ago(rng, 0, 1)
        start = arrival - dt.timedelta(days=rng.randint(7, 21))
        try:
            ctx.conn.execute(
                """INSERT INTO corporation_mining_extractions
                (corporation_id, structure_id, moon_id, chunk_arrival_time,
                extraction_start_time, natural_decay_time)
                VALUES (?,?,?,?,?,?)""",
                (corp, struct, moon[0], iso_z(arrival), iso_z(start), iso_z(decay)),
            )
            ctx.bump("corporation_mining_extractions")
            rows += 1
        except sqlite3.IntegrityError:
            pass  # duplicate (corp,struct,moon) PK; skip


