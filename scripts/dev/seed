def seed_captains_log(ctx):
    """Captain's Log demo data: logged days of varying completeness plus the kill
    reports, skill completions and calendar-event notes that back the day states.

    Dates anchor on LOG_NOW so the "Today" entry is always current. The days:
      offset 0  Today       -- busy day, fully answered, combat debriefed
      offset 1  yesterday   -- incomplete: a loss whose debrief is missing
      offset 2  fight day   -- complete: three kills, two losses, all debriefed
      offset 3  trade day   -- complete: no combat, industry + event note
      offset 4  activity-only -- killmails but NO captains_log row
      offset 9  builder day -- incomplete: no goal set
    """
    conn = ctx.conn
    skills = {name: sid for sid, name in ctx.pools.get("skills", [])}
    chars = ctx.chars

    def ch(i):
        return chars[i % len(chars)]

    km_counter = [0]
    ev_counter = [0]
    sc_counter = [0]

    def day(offset, hour=20):
        return (LOG_NOW - dt.timedelta(days=offset)).replace(
            hour=hour, minute=0, second=0, microsecond=0)

    def make_kill(char, is_kill, when):
        km_counter[0] += 1
        km = _gen_killmail(ctx, BASE_CL_KILLMAIL + km_counter[0], char, is_kill)
        km["kill_time"] = iso_z(when)
        km["synced_at"] = iso_offset(when + dt.timedelta(hours=2))
        _insert_char_killmail(ctx, char["id"], km)
        if char["corp"] == ctx.main_corp:
            _insert_corp_killmail(ctx, ctx.main_corp, km)
        return km

    def make_report(char, km, outcome, happened, different, takeaway, when):
        ts = iso_offset(when + dt.timedelta(hours=2, minutes=14))
        conn.execute(
            """INSERT INTO killmail_report
            (character_id, killmail_id, outcome, happened, different, takeaway,
            created_at, updated_at) VALUES (?,?,?,?,?,?,?,?)""",
            (char["id"], km["killmail_id"], outcome, happened, different, takeaway,
            ts, ts),
        )
        ctx.bump("killmail_report")

    def log_row(when, narrative=None, goal=None, remember=None, blocked=None,
                build=None, skill=None, combat=None, next=None, research=None):
        ts = iso_offset(when + dt.timedelta(hours=3))
        conn.execute(
            """INSERT INTO captains_log
            (date, narrative, goal, remember, blocked, build, skill, combat, next,
            research, created_at, updated_at)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?)""",
            (date_only(when), narrative, goal, remember, blocked, build, skill,
            combat, next, research, ts, ts),
        )
        ctx.bump("captains_log")

    def skill_done(char, skill_name, level, when, verified=True):
        sid = skills.get(skill_name)
        if sid is None:
            return
        ts = iso_offset(when)
        sc_counter[0] += 1
        conn.execute(
            """INSERT INTO skill_completion
            (id, character_id, skill_id, level, completed_at, verified,
            created_at, updated_at) VALUES (?,?,?,?,?,?,?,?)""",
