def seed_industry_jobs(ctx):
    rng = ctx.rng
    activities = [ACT_MANUFACTURING, ACT_TE, ACT_ME, ACT_COPY, ACT_INVENTION, ACT_REACTION]
    jid = [0]

    def next_char_jid():
        jid[0] += 1
        return BASE_CHAR_JOB + jid[0]

    for ch in ctx.chars:
        n_total = rng.randint(12, 18)
        n_active = rng.randint(9, 12)
        n_finished = rng.randint(3, 5)
        kinds = (["active"] * n_active
                + ["delivered", "ready"] * (n_finished // 2 + 1)
                + ["paused"])
        kinds = kinds[:n_total]
        # ensure activity coverage
        act_cycle = activities[:]
        for i, kind in enumerate(kinds):
            activity = act_cycle[i % len(act_cycle)] if i < len(act_cycle) else rng.choice(activities)
            j = _make_job(ctx, next_char_jid(), "char", ch["id"], ch["id"], activity, kind)
            _insert_char_job(ctx, ch["id"], j)

    # corp jobs
    cjid = [0]

    def next_corp_jid():
        cjid[0] += 1
        return BASE_CORP_JOB + cjid[0]

    director = ctx.director["id"] if ctx.director else ctx.chars[0]["id"]
    corp = ctx.main_corp
    n_corp = rng.randint(10, 16)
    corp_acts = ([ACT_MANUFACTURING] * 5 + [ACT_REACTION] * 3 + [ACT_INVENTION]
                + [ACT_TE, ACT_ME, ACT_COPY] + [ACT_MANUFACTURING] * 4)
    corp_kinds = (["active"] * (n_corp - 4) + ["delivered", "ready", "paused", "active"])
    rng.shuffle(corp_kinds)
    for i in range(n_corp):
        activity = corp_acts[i % len(corp_acts)]
        kind = corp_kinds[i % len(corp_kinds)]
        j = _make_job(ctx, next_corp_jid(), "corp", corp, director, activity, kind)
        _insert_corp_job(ctx, corp, j)


