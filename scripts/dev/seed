class Ctx:
    def __init__(self, conn, rng, pools):
        self.conn = conn
        self.rng = rng
        self.pools = pools
        self.counts = {}
        chars = query(conn, "SELECT id, name, corporation_id FROM characters ORDER BY id")
        self.chars = [{"id": c[0], "name": c[1], "corp": c[2]} for c in chars]
        self.char_by_id = {c["id"]: c for c in self.chars}

        # main corp = a char-corp >= 98000000 (player corp); else most common.
        player = [c["corp"] for c in self.chars if c["corp"] and c["corp"] >= 98_000_000]
        if player:
            self.main_corp = player[0]
        elif self.chars:
            corps = [c["corp"] for c in self.chars]
            self.main_corp = max(set(corps), key=corps.count)
        else:
            self.main_corp = PLAYER_CORP_FALLBACK
        # installer / director = first char in the main corp
        members = [c for c in self.chars if c["corp"] == self.main_corp]
        self.director = members[0] if members else (self.chars[0] if self.chars else None)

    def bump(self, table, n=1):
        self.counts[table] = self.counts.get(table, 0) + n

    def name_of(self, cid):
        c = self.char_by_id.get(cid)
        return c["name"] if c else "Pilot %d" % cid


