                round(corp_balance if division == 1 else rng.uniform(0, 5_000_000), 2),
                None, None, director, None, corp, None, None),
            )
            ctx.bump("corporation_wallet_journal")
            if division == 1:
                corp_balance -= amount

    # --- corp contracts ---
    seed_corp_contracts(ctx, tradeable, hub_stations)

    # --- net worth snapshots ---
    seed_net_worth(ctx)


