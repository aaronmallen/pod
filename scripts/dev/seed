def seed_standings(ctx):
    rng = ctx.rng
    pools = ctx.pools
    factions = pools["factions"]
    npc_corps = pools["npc_corps"]
    agents = pools["npc_agents"]
    for ch in ctx.chars:
        cid = ch["id"]
        rows = []
        for f in weighted_sample(rng, factions, min(5, len(factions))):
            rows.append((f[0], "faction", round(rng.uniform(-6.0, 9.0), 2), f[1]))
        for c in weighted_sample(rng, npc_corps, min(6, len(npc_corps))):
            rows.append((c[0], "npc_corp", round(rng.uniform(-3.0, 8.0), 2), c[1]))
        for a in weighted_sample(rng, agents, min(4, len(agents))):
            rows.append((a[0], "agent", round(rng.uniform(0.0, 7.0), 2), a[1]))
        seen = set()
        for from_id, ftype, standing, fname in rows:
            if from_id in seen:
                continue
            seen.add(from_id)
            ctx.conn.execute(
                """INSERT INTO character_standings
                (character_id, from_id, from_type, standing, from_name)
                VALUES (?,?,?,?,?)""",
                (cid, from_id, ftype, standing, fname),
            )
            ctx.bump("character_standings")


