{
  "name": "pod-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "[ -f src/generated/release.ts ] || cp src/generated/release.example.ts src/generated/release.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "fetch-release": "tsx scripts/fetch-release.ts",
    "parse-changelog": "tsx scripts/parse-changelog.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.2"
  },
  "aube": {
    "allowBuilds": {
      "esbuild": "set this to true or false"
    }
  }
}
